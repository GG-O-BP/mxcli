-- ============================================================================
-- NEGATIVE TEST: literal credentials on a database connection must be refused
-- ============================================================================
--
-- `connection string`, `username` and `password` are ConstantIdentifier
-- properties — BY_NAME references to a Constant document, with no literal
-- alternative. The grammar accepts a bare string there anyway, and writing one
-- produced a project Mendix CANNOT LOAD:
--
--   StorageLoadException: One or more invalid values were detected while loading
--   the project: Database Connection 'Bad.Conn' has an invalid value '' for
--   property ConnectionString. The text 'jdbc:postgresql://...' is not a valid
--   ConstantIdentifier.
--
-- Not a build error — `mx check` dies during load, so the whole project goes
-- down rather than one document. Same class as upstream #854.
--
-- This script MUST fail `mxcli check` with MDL058 (three times: one per
-- property). The working form is in 863-execute-database-query-describe.mdl.
-- ============================================================================

create module BadConn;

create database connection BadConn.Conn
  type 'PostgreSQL'
  connection string 'jdbc:postgresql://localhost:5432/app'
  username 'app'
  password 'secret';
